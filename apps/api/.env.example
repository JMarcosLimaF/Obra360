# Copie para apps/api/.env. Segredos não entram no git.

# Supabase (Project Settings). URL do projeto, publishable key, secret key
# e JWKS (em geral https://<ref>.supabase.co/auth/v1/.well-known/jwks.json).
# A secret key não vai para o navegador.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

NODE_ENV=development
HOST=127.0.0.1
PORT=3333
PUBLIC_URL=http://localhost:5199
CORS_ORIGINS=http://localhost:5199

# duração do cookie de refresh, em horas
SESSION_HOURS=12
COOKIE_SECURE=false

# vazio = a IA responde com texto simulado, sem chave no navegador
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# vazio = a API sobe sem fila; o worker Python fica desligado
REDIS_URL=

# a carga de exemplo foi escrita em torno desta data
OBRA360_TODAY=2026-08-30
APP_TZ=America/Maceio
